# =========================================================
#  MODA — E-Commerce · variables de entorno de plantilla
#  Copia este archivo a ".env" y rellena los valores reales
#  NUNCA subas .env al repositorio.
# =========================================================

APP_NAME="MODA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

# Mantenimiento (driver recomendado en producción: "cache")
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---- Base de datos (recomendado MySQL/MariaDB en producción) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moda
DB_USERNAME=moda_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Para desarrollo local con SQLite, comenta lo anterior y usa:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ---- Cache, sesiones, colas ----
# CACHE en Redis: las peticiones muy seguidas (catálogo, detalle de producto,
# home, carrito, agregados admin) se sirven desde Redis en RAM. Requiere la
# extensión PHP ext-redis (phpredis) o el paquete predis/predis con
# REDIS_CLIENT=predis. Si Redis cae, el CacheService cae con elegancia y
# sirve desde la BD sin caché.
CACHE_STORE=redis
# SESIONES en BD (no en Redis): el atributo User::is_online consulta la tabla
# `sessions` por user_id; en Redis las sesiones no se indexan por usuario y no
# se podría derivar "online". Para escalar sesiones a Redis, reimplementar
# is_online con un set de presencia separado.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database

# ---- Redis ----
# Conexión por defecto (sesiones, rate limiting, locks) y conexión 'cache'
# dedicada (pueden usar distinto DB index de Redis para aislar evicciones).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---- Filesystem (por defecto local; en producción S3 recomendado) ----
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=noresponder@tudominio.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noresponder@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Sanctum / API ----
SANCTUM_STATEFUL_DOMAINS=tudominio.com
SANCTUM_TOKEN_PREFIX=moda_

# ---- Admin bootstrap ----
# Contraseña del usuario admin creado por AdminUserSeeder.
# Déjala vacía para generar una aleatoria segura (se imprime por consola).
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@tudominio.com
ADMIN_NAME="Administrador"

# ---- Pasarela de pago (placeholder; integrar Stripe/Redsys/MercadoPago) ----
# PAYMENTS_DRIVER=stripe
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
